DirectoryIndex index.php index.html
AddType application/json .json
AddType application/manifest+json .webmanifest
Options -Indexes

# Operation scope enforce mode — ativar quando todos os guards passarem (Fase H.5)
<IfModule mod_env.c>
  SetEnv BIOMIE_OPERATION_SCOPE_ENFORCED 1
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(index|vendedores|pedidos|mercadorias|financeiro|plano_voo|plano_voo_metas|integracoes)\.html$ $1.php [R=302,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # HTML/PHP autenticado e APIs não devem ficar presos no browser/cache intermediario.
  <FilesMatch "\.(php)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # Service worker e manifest precisam revalidar sempre para trocar a versao do cache.
  <FilesMatch "^(sw\.js|site\.webmanifest|manifest\.json)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # Assets estaticos podem ter cache forte porque o PageAssetRegistry injeta ?v=filemtime.
  <FilesMatch "\.(?:css|js|png|svg|ico|jpg|jpeg|webp|woff2?)$">
    Header always set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://images.unsplash.com https://plus.unsplash.com; connect-src 'self' https://app.omie.com.br; frame-ancestors 'none'; form-action 'self'"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteRule ^\.well-known/ - [L]

  # BIomie public surface hardening: deny internal project files by default.
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^(app|bin|biomie-local|config|cron|cronjobs|database|docs|install|storage|tests|tools|vendor)(/|$) - [F,L,NC]
  RewriteRule (^|/)(composer\.(json|lock)|phpstan.*\.neon|.*\.(env|ini|log|jsonl|lock|sql|bak|backup|old|orig|swp|dist|example|md|map))$ - [F,L,NC]
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|composer\.(json|lock)$|phpstan.*\.neon$|.*\.(env|ini|log|jsonl|lock|sql|bak|backup|old|orig|swp|dist|example|md|map)$)">
    Require all denied
  </FilesMatch>
</IfModule>
