{
  "company": "ergooffice",
  "version": "1.0",
  "note": "Referência de design. Runtime usa CSS variables (--chart-*) lidas por B.chartTheme().",
  "semantic": {
    "revenue":     { "color": "#AD5500", "label": "Faturamento / dado principal",          "css": "--chart-revenue" },
    "target":      { "color": "#16A34A", "label": "Meta / crescimento / sucesso",          "css": "--chart-target" },
    "opportunity": { "color": "#E8811A", "label": "Oportunidade / energia (brand accent)", "css": "--chart-opportunity" },
    "pending":     { "color": "#F59E0B", "label": "Pendente / atenção",                    "css": "--chart-pending" },
    "cancelled":   { "color": "#DC2626", "label": "Cancelado / perda",                     "css": "--chart-cancelled" },
    "neutral":     { "color": "#64748B", "label": "Neutro / histórico",                    "css": "--chart-neutral" }
  },
  "rule": "Laranja escuro = dado principal. Laranja vivo = oportunidade/energia. Verde = bom. Âmbar = atenção. Contraste escuro-vivo cria profundidade nos charts ERGO.",
  "config": {
    "barRadius": 6,
    "lineTension": 0.3,
    "gridColor": "#E2E8F0",
    "labelColor": "#64748B",
    "titleColor": "#1A1A1A"
  }
}
