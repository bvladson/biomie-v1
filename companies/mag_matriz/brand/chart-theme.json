{
  "company": "mag_matriz",
  "version": "1.0",
  "note": "Referência de design. Runtime usa CSS variables (--chart-*) lidas por B.chartTheme().",
  "semantic": {
    "revenue":     { "color": "#9B1A1A", "label": "Faturamento / dado principal",    "css": "--chart-revenue" },
    "target":      { "color": "#16A34A", "label": "Meta / crescimento",              "css": "--chart-target" },
    "opportunity": { "color": "#2563EB", "label": "Oportunidade / pipeline",          "css": "--chart-opportunity" },
    "pending":     { "color": "#F59E0B", "label": "Pendente / atenção",               "css": "--chart-pending" },
    "cancelled":   { "color": "#DC2626", "label": "Cancelado / perda",                "css": "--chart-cancelled" },
    "neutral":     { "color": "#64748B", "label": "Neutro / histórico",               "css": "--chart-neutral" },
    "group_chart2":{ "color": "#A86B00", "label": "Âmbar ouro — comparativo de grupo", "css": "--page-chart-2" }
  },
  "rule": "Igual MAG Filial, mas chart-2 usa ouro corporativo para identificar a Matriz em dashboards consolidados.",
  "config": {
    "barRadius": 6,
    "lineTension": 0.3,
    "gridColor": "#E2E8F0",
    "labelColor": "#64748B",
    "titleColor": "#1A1A1A"
  }
}
